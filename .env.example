# Copy to .env.local and adjust. None of these are required to run the demo.
# Never put secret keys in variables prefixed with NEXT_PUBLIC_ — they are exposed to the browser.

# Public URL of your deployment, used for canonical URLs, sitemap and Open Graph tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: POST endpoint that receives newsletter sign-ups as JSON { email, store }.
# Leave empty to keep the newsletter form in clearly labelled demo mode.
NEXT_PUBLIC_NEWSLETTER_ENDPOINT=

# Optional: POST endpoint (e.g. a Formspree form URL) that receives contact-form submissions as JSON.
# Leave empty to keep the contact form in clearly labelled demo mode.
NEXT_PUBLIC_CONTACT_ENDPOINT=
