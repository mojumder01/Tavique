{
  "name": "tavique",
  "version": "1.0.0",
  "private": true,
  "description": "Tavique — premium multi-niche e-commerce template (Fashion, Electronics, Beauty) built with Next.js, TypeScript and Tailwind CSS.",
  "license": "SEE LICENSE IN LICENSE.md",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
